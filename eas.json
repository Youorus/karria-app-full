{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_MODE": "simulation",
        "EXPO_PUBLIC_ADMOB_TEST_MODE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_MODE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_MODE": "false",
        "EXPO_PUBLIC_ADMOB_NATIVE_IOS": "ca-app-pub-3330048630750788/2234634875",
        "EXPO_PUBLIC_ADMOB_NATIVE_ANDROID": "ca-app-pub-3330048630750788/5303498413",
        "EXPO_PUBLIC_ADMOB_FEED_INTERVAL": "7"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
